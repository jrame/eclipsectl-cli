cmd_debug_config_create_java() {
    [ -z "${1:-}" ] && die "Usage: eclipse debug config create-java <main-class> [options]"
    local main_class="$1"
    local args
    args=$(jq -cn --arg main_class "$main_class" \
        '{mainClass:$main_class,appendSystemEnvironment:true,nameConflict:"error"}')
    shift

    while [ $# -gt 0 ]; do
        case "$1" in
            --name)
                [ $# -lt 2 ] && die "--name requires a value"
                args=$(jq -c --arg value "$2" '.configName=$value' <<< "$args")
                shift 2
                ;;
            --type)
                [ $# -lt 2 ] && die "--type requires java, junit4, junit5, testng, or auto"
                case "$2" in java|junit4|junit5|testng|auto) ;; *) die "--type must be java, junit4, junit5, testng, or auto" ;; esac
                args=$(jq -c --arg value "$2" '.type=$value' <<< "$args")
                shift 2
                ;;
            --project|-p)
                [ $# -lt 2 ] && die "--project requires a value"
                args=$(jq -c --arg value "$2" '.projectName=$value' <<< "$args")
                shift 2
                ;;
            --program-arguments)
                [ $# -lt 2 ] && die "--program-arguments requires a value"
                args=$(jq -c --arg value "$2" '.programArguments=$value' <<< "$args")
                shift 2
                ;;
            --vm-arguments)
                [ $# -lt 2 ] && die "--vm-arguments requires a value"
                args=$(jq -c --arg value "$2" '.vmArguments=$value' <<< "$args")
                shift 2
                ;;
            --working-directory)
                [ $# -lt 2 ] && die "--working-directory requires a value"
                local working_directory
                working_directory=$(to_windows_path "$2")
                args=$(jq -c --arg value "$working_directory" '.workingDirectory=$value' <<< "$args")
                shift 2
                ;;
            --env)
                [ $# -lt 2 ] && die "--env requires NAME=VALUE"
                case "$2" in
                    *=*) [ -n "${2%%=*}" ] || die "Invalid environment variable '$2'; expected NAME=VALUE" ;;
                    *) die "Invalid environment variable '$2'; expected NAME=VALUE" ;;
                esac
                local env_name="${2%%=*}"
                local env_value="${2#*=}"
                args=$(jq -c --arg name "$env_name" --arg value "$env_value" \
                    '.environmentVariables = (.environmentVariables // {}) | .environmentVariables[$name]=$value' <<< "$args")
                shift 2
                ;;
            --append-system-environment)
                args=$(jq -c '.appendSystemEnvironment=true' <<< "$args")
                shift
                ;;
            --no-append-system-environment)
                args=$(jq -c '.appendSystemEnvironment=false' <<< "$args")
                shift
                ;;
            --name-conflict)
                [ $# -lt 2 ] && die "--name-conflict requires error or generate"
                case "$2" in error|generate) ;; *) die "--name-conflict must be error or generate" ;; esac
                args=$(jq -c --arg value "$2" '.nameConflict=$value' <<< "$args")
                shift 2
                ;;
            *) die "Unknown create-java option: $1" ;;
        esac
    done

    daemon_call "$(build_json create_java_launch_configuration "$args")"
}

cmd_debug_config_show() {
    [ -z "${1:-}" ] && die "Usage: eclipse debug config show <configuration> [--include-environment-values]"
    local config_name="$1"
    local include_values=false
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            --include-environment-values) include_values=true; shift ;;
            *) die "Unknown config show option: $1" ;;
        esac
    done
    local args
    args=$(jq -cn --arg config_name "$config_name" --argjson include_values "$include_values" \
        '{configName:$config_name,includeEnvironmentValues:$include_values}')
    daemon_call "$(build_json get_launch_configuration "$args")"
}

cmd_debug_config_update_environment() {
    [ -z "${1:-}" ] && die "Usage: eclipse debug config update-environment <configuration> [options]"
    local config_name="$1"
    local update_mode=merge
    local has_removals=false
    local args
    args=$(jq -cn --arg config_name "$config_name" \
        '{configName:$config_name,updateMode:"merge"}')
    shift

    while [ $# -gt 0 ]; do
        case "$1" in
            --variable|--env)
                [ $# -lt 2 ] && die "$1 requires NAME=VALUE"
                case "$2" in
                    *=*) [ -n "${2%%=*}" ] || die "Invalid environment variable '$2'; expected NAME=VALUE" ;;
                    *) die "Invalid environment variable '$2'; expected NAME=VALUE" ;;
                esac
                local env_name="${2%%=*}"
                local env_value="${2#*=}"
                args=$(jq -c --arg name "$env_name" --arg value "$env_value" \
                    '.variables = (.variables // {}) | .variables[$name]=$value' <<< "$args")
                shift 2
                ;;
            --remove-variable)
                [ $# -lt 2 ] && die "--remove-variable requires a variable name"
                [ -z "$2" ] && die "--remove-variable requires a non-empty variable name"
                has_removals=true
                args=$(jq -c --arg value "$2" \
                    '.removeVariables = (.removeVariables // []) + [$value]' <<< "$args")
                shift 2
                ;;
            --mode)
                [ $# -lt 2 ] && die "--mode requires merge or replace"
                case "$2" in merge|replace) ;; *) die "--mode must be merge or replace" ;; esac
                update_mode="$2"
                args=$(jq -c --arg value "$update_mode" '.updateMode=$value' <<< "$args")
                shift 2
                ;;
            --append-system-environment)
                args=$(jq -c '.appendSystemEnvironment=true' <<< "$args")
                shift
                ;;
            --no-append-system-environment)
                args=$(jq -c '.appendSystemEnvironment=false' <<< "$args")
                shift
                ;;
            *) die "Unknown update-environment option: $1" ;;
        esac
    done

    if [ "$update_mode" = replace ]; then
        [ "$has_removals" = true ] && die "--remove-variable cannot be used with --mode replace"
        args=$(jq -c '.variables = (.variables // {})' <<< "$args")
    fi
    daemon_call "$(build_json update_launch_environment "$args")"
}

