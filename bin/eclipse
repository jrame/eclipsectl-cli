# --- Search commands ---
cmd_search_text() {
    [ -z "${1:-}" ] && die "Usage: eclipse search text <pattern> [filePattern...]"
    local pattern="$1"
    local file_patterns='null'
    if [ -n "${2:-}" ]; then
        file_patterns=$(printf '%s\n' "${@:2}" | jq -R . | jq -s .)
    fi
    daemon_call "$(build_json file_search "{\"containingText\":\"$pattern\",\"fileNamePatterns\":$file_patterns}")"
}

cmd_search_regex() {
    [ -z "${1:-}" ] && die "Usage: eclipse search regex <pattern> [filePattern...]"
    local pattern="$1"
    local file_patterns='null'
    if [ -n "${2:-}" ]; then
        file_patterns=$(printf '%s\n' "${@:2}" | jq -R . | jq -s .)
    fi
    daemon_call "$(build_json file_search_regexp "{\"pattern\":\"$pattern\",\"fileNamePatterns\":$file_patterns}")"
}

cmd_search_files() {
    local file_patterns='null'
    local max_results=200
    if [ -n "${1:-}" ]; then
        file_patterns=$(printf '%s\n' "$@" | jq -R . | jq -s .)
    fi
    daemon_call "$(build_json find_files "{\"fileNamePatterns\":$file_patterns,\"maxResults\":\"$max_results\"}")"
}

