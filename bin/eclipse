cmd_editor_open() {
    [ -z "${1:-}" ] && die "Usage: eclipse editor open <file> [--line N] [--project P]"
    local file line="" project=""
    file=$(to_json_path "$1")
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            --line|-l) line="$2"; shift 2 ;;
            --project|-p) project="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    local args="{\"file\":\"$file\""
    [ -n "$line" ] && args="$args,\"line\":$line"
    [ -n "$project" ] && args="$args,\"project\":\"$project\""
    args="$args}"
    daemon_call "$(build_json open_file "$args")"
}

