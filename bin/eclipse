# --- Java commands ---
cmd_java_write() {
    [ -z "${1:-}" ] && die "Usage: eclipse java write <file> [source_code] [--project P] [--class C]

Examples:
  eclipse java write src/Main.java 'public void hello() { }'
  eclipse java write src/Main.java << 'EOF'
  public void hello() {
      System.out.println(\"Hello\");
  }
  EOF"

    local file source_code="" project="" classname=""
    file="$1"
    shift

    # Check if second arg is a flag or source code
    if [ -n "${1:-}" ] && [[ ! "$1" =~ ^- ]]; then
        source_code="$1"
        shift
    fi

    # Parse flags
    while [ $# -gt 0 ]; do
        case "$1" in
            --project|-p) project="$2"; shift 2 ;;
            --class|-c) classname="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    # If no source_code provided, read from stdin
    if [ -z "$source_code" ]; then
        source_code=$(cat)
    fi

    source_code=$(escape_json_string "$source_code")
    local args="{\"filePath\":\"$file\",\"newSource\":\"$source_code\""
    [ -n "$project" ] && args="$args,\"projectName\":\"$project\""
    [ -n "$classname" ] && args="$args,\"className\":\"$classname\""
    args="$args}"
    daemon_call "$(build_json write_java "$args")"
}

cmd_java_remove() {
    [ -z "${1:-}" ] && die "Usage: eclipse java remove <file> [members] [--project P] [--class C]

Examples:
  eclipse java remove src/Main.java 'oldMethod,deprecatedField'
  eclipse java remove src/Main.java << 'EOF'
  oldMethod
  deprecatedField
  unusedVariable
  EOF"

    local file members="" project="" classname=""
    file="$1"
    shift

    # Check if second arg is a flag or members list
    if [ -n "${1:-}" ] && [[ ! "$1" =~ ^- ]]; then
        members="$1"
        shift
    fi

    # Parse flags
    while [ $# -gt 0 ]; do
        case "$1" in
            --project|-p) project="$2"; shift 2 ;;
            --class|-c) classname="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    # If no members provided, read from stdin (one per line or comma-separated)
    if [ -z "$members" ]; then
        members=$(cat | tr '\n' ',' | sed 's/,$//')
    fi

    local args="{\"filePath\":\"$file\",\"members\":\"$members\""
    [ -n "$project" ] && args="$args,\"projectName\":\"$project\""
    [ -n "$classname" ] && args="$args,\"className\":\"$classname\""
    args="$args}"
    daemon_call "$(build_json remove_java "$args")"
}

cmd_java_read() {
    [ -z "${1:-}" ] && die "Usage: eclipse java read <file> [--project P] [--class C]"
    local file project="" classname=""
    file="$1"
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            --project|-p) project="$2"; shift 2 ;;
            --class|-c) classname="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    local args="{\"filePath\":\"$file\""
    [ -n "$project" ] && args="$args,\"projectName\":\"$project\""
    [ -n "$classname" ] && args="$args,\"className\":\"$classname\""
    args="$args}"
    daemon_call "$(build_json read_java "$args")"
}

# --- Remove commands ---
cmd_remove_lines() {
    [ -z "${2:-}" ] && die "Usage: eclipse remove lines <file> <lines> [--project P]"
    local file lines project=""
    file=$(to_json_path "$1")
    lines="$2"
    shift 2
    while [ $# -gt 0 ]; do
        case "$1" in
            --project|-p) project="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    local args="{\"filePath\":\"$file\",\"lines\":\"$lines\""
    [ -n "$project" ] && args="$args,\"projectName\":\"$project\""
    args="$args}"
    daemon_call "$(build_json remove_lines "$args")"
}

# --- Gate commands ---
cmd_gate_reset() {
    local file="" project=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --project|-p) project="$2"; shift 2 ;;
            --file|-f) file=$(to_json_path "$2"); shift 2 ;;
            *)
                if [ -z "$file" ]; then
                    file=$(to_json_path "$1")
                fi
                shift
                ;;
        esac
    done
    local args='{'
    local first=true
    if [ -n "$project" ]; then
        args="$args\"projectName\":\"$project\""
        first=false
    fi
    if [ -n "$file" ]; then
        [ "$first" = false ] && args="$args,"
        args="$args\"filePath\":\"$file\""
    fi
    args="$args}"
    daemon_call "$(build_json reset_read_gate "$args")"
}

# --- Run commands ---
cmd_run() {
    local config="" wait=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --wait|-w) wait=true; shift ;;
            *) config="$1"; shift ;;
        esac
    done
    local args='{}'
    if [ -n "$config" ] && [ "$wait" = true ]; then
        args="{\"configuration\":\"$config\",\"wait\":true}"
    elif [ -n "$config" ]; then
        args="{\"configuration\":\"$config\"}"
    elif [ "$wait" = true ]; then
        args="{\"wait\":true}"
    fi
    daemon_call "$(build_json run "$args")"
}

# --- Refresh commands ---
