#!/bin/bash
# Eclipse CLI - Ultra-fast Bash wrapper for the persistent Eclipse daemon
# Avoids starting a Python CLI process for every command

set -euo pipefail

SOCKET="$HOME/.config/eclipsectl-cli/daemon.sock"
PID_FILE="$HOME/.config/eclipsectl-cli/daemon.pid"
CONFIG_FILE_GLOBAL="$HOME/.config/eclipsectl-cli/config.json"
CONFIG_FILE_LOCAL=".config/eclipsectl-cli/config.json"

# ===== Helper functions =====

die() {
    echo "Error: $*" >&2
    exit 1
}

# Convert WSL path to Windows path if needed
to_windows_path() {
    local path="$1"
    if [[ "$path" == /mnt/* ]]; then
        wslpath -w "$path"
    else
        echo "$path"
    fi
}

# Escape string for JSON (backslashes, quotes, newlines, tabs, carriage returns)
escape_json_string() {
    local str="$1"
    str="${str//\\/\\\\}"
    str="${str//\"/\\\"}"
    str="${str//$'\t'/\\t}"
    str="${str//$'\r'/\\r}"
    str="${str//$'\n'/\\n}"
    echo "$str"
}

# Convert to Windows path and escape for JSON
to_json_path() {
    local path=$(to_windows_path "$1")
    escape_json_string "$path"
}

# Check if daemon is running
is_daemon_running() {
    [ -S "$SOCKET" ] && [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null
}

# Remove IPC files left behind by a daemon that is no longer running.
# This must only be called after is_daemon_running has returned false.
remove_stale_daemon_files() {
    rm -f -- "$SOCKET" "$PID_FILE"
}

# The daemon writes its PID only after the Unix server is listening. Requiring
# both files to belong to the process we just started prevents a stale socket
# from being mistaken for a ready daemon.
is_started_daemon_ready() {
    local expected_pid="$1"
    local recorded_pid

    [ -S "$SOCKET" ] || return 1
    [ -f "$PID_FILE" ] || return 1
    recorded_pid=$(cat "$PID_FILE" 2>/dev/null) || return 1
    [ "$recorded_pid" = "$expected_pid" ] || return 1
    kill -0 "$expected_pid" 2>/dev/null
}

# Start daemon if not running
ensure_daemon() {
    if ! is_daemon_running; then
        echo "🚀 Starting Eclipse daemon..." >&2

        # Check config exists (try local first, then global)
        if [ ! -f "$CONFIG_FILE_LOCAL" ] && [ ! -f "$CONFIG_FILE_GLOBAL" ]; then
            echo "" >&2
            echo "❌ Configuration file not found!" >&2
            echo "" >&2
            echo "Checked locations:" >&2
            echo "  1. Local (project):  $(pwd)/$CONFIG_FILE_LOCAL" >&2
            echo "  2. Global (user):    $CONFIG_FILE_GLOBAL" >&2
            echo "" >&2
            echo "Create one of these files with the following content:" >&2
            echo "" >&2
            echo '{' >&2
            echo '  "eclipse_url": "http://localhost:8124",' >&2
            echo '  "bearer_token": "YOUR_BEARER_TOKEN_HERE"' >&2
            echo '}' >&2
            echo "" >&2
            echo "To get your bearer token:" >&2
            echo "  Eclipse → Window → Preferences → eclipsectl-mcp → HTTP MCP Server → Generate Token" >&2
            echo "" >&2
            exit 1
        fi

        # A daemon killed before its cleanup phase can leave these files
        # behind. Remove them before launching so readiness checks cannot see
        # state from the previous process.
        remove_stale_daemon_files

        # Start daemon via Python (capture stderr for errors)
        local daemon_log="/tmp/eclipse_daemon_startup.log"
        python3 -m eclipsectl_cli.daemon >"$daemon_log" 2>&1 &
        local daemon_pid=$!
        local daemon_ready=false

        # Wait for the socket and PID file created by this exact process.
        for i in {1..50}; do
            if is_started_daemon_ready "$daemon_pid"; then
                daemon_ready=true
                break
            fi

            # Stop waiting as soon as the new daemon has exited.
            kill -0 "$daemon_pid" 2>/dev/null || break
            sleep 0.2
        done

        if [ "$daemon_ready" = true ]; then
            echo "✅ Daemon ready!" >&2
            rm -f "$daemon_log"
        else
            # Daemon failed to start, show detailed error
            echo "" >&2
            echo "❌ Daemon failed to start" >&2
            echo "" >&2
            if [ -f "$daemon_log" ] && [ -s "$daemon_log" ]; then
                # Show the actual error from daemon log
                cat "$daemon_log" >&2
                rm -f "$daemon_log"
            else
                # No log or empty log - show generic troubleshooting
                echo "No error details available. Possible causes:" >&2
                echo "  1. Eclipse IDE is not running on Windows" >&2
                echo "  2. eclipsectl-mcp plugin is not installed or enabled" >&2
                echo "  3. HTTP MCP Server is not enabled in: Window → Preferences → eclipsectl-mcp → HTTP MCP Server" >&2
                echo "  4. Network issue or firewall blocking connection" >&2
                echo "  5. Invalid bearer token in config (check $CONFIG_FILE_GLOBAL or $(pwd)/$CONFIG_FILE_LOCAL)" >&2
                echo "" >&2
                echo "Check daemon log for details: tail -f ~/.config/eclipsectl-cli/daemon.log" >&2
            fi
            exit 1
        fi
    fi
}

# Call daemon with JSON command
daemon_call() {
    local json="$1"

    ensure_daemon

    # Send request and parse response
    local response
    response=$(echo "$json" | nc -U "$SOCKET" -w 5 2>/dev/null) || die "Daemon communication failed"

    # Check if successful
    if echo "$response" | jq -e '.success' &>/dev/null; then
        echo "$response" | jq -r '.result'
    else
        local error
        error=$(echo "$response" | jq -r '.error // "Unknown error"')
        # Strip Java exception prefixes for cleaner output
        error="${error#RuntimeException: }"
        error="${error#Error: }"
        die "$error"
    fi
}

# Build JSON request
build_json() {
    local cmd="$1"
    shift
    local args="$*"

    # No escaping - args is already valid JSON
    echo "{\"command\":\"$cmd\",\"args\":$args}"
}

# ===== Command implementations =====

# --- Project commands ---
cmd_project_list() {
    daemon_call '{"command":"list_projects","args":{}}'
}

cmd_project_layout() {
    [ -z "${1:-}" ] && die "Usage: eclipse project layout <project>"
    daemon_call "$(build_json get_project_layout "{\"project\":\"$1\"}")"
}

