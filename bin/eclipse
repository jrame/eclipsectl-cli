    [ -z "${2:-}" ] && die "Usage: eclipse coverage class <project> <className>"
    daemon_call "$(build_json get_class_coverage "{\"projectName\":\"$1\",\"className\":\"$2\"}")"
}

# --- Daemon commands ---
cmd_daemon_status() {
    if is_daemon_running; then
        echo "✅ Daemon is running (PID: $(cat "$PID_FILE"))"
        exit 0
    else
        echo "Error: Daemon is not running"
        exit 1
    fi
}

cmd_daemon_stop() {
    if is_daemon_running; then
        daemon_call '{"command":"shutdown","args":{}}'
        echo "✅ Daemon stopped"
    else
        echo "Daemon is not running"
    fi
}

cmd_daemon_restart() {
    cmd_daemon_stop 2>/dev/null || true
    sleep 1
    ensure_daemon
    echo "✅ Daemon restarted"
}

show_help() {
    cat << 'EOF'
Eclipse IDE CLI - Ultra-fast control of Eclipse from WSL

USAGE:
    eclipse <command> [args...]

WORKSPACE:
    workspace info                            Show workspace info (location, projects, versions)

PROJECT COMMANDS:
    project list                              List all projects
    project layout <project>                  Show project structure
    project properties <project>              Show project properties
    project read <project> <path>             Read project file content
    project import <path>                     Import project into workspace

CODE ANALYSIS:
    code javadoc <fqn>                       Get JavaDoc for fully qualified class
    code source <fqn>                        Get source for fully qualified class
    code hierarchy <fqn> <method>            Get call hierarchy for class method

BUILD & TESTS:
    build maven <project> <goals...>         Run Maven build
    build errors [project]                   Get compilation errors
    test all                                 Run all tests
    test package <project> <package>         Run package tests
    test class <project> <class>             Run class tests
    test method <project> <class> <method>   Run test method

EDITOR:
    editor current                           Get currently opened file
    editor selection                         Get current selection
    editor format <file>                     Format code file
    editor open <file> [--line N] [--project P]  Open file in Eclipse editor
    editor list                              List open editors (* = active)

CONSOLE:
    console output [name]                    Get console output

SEARCH:
    search text <pattern> [filePattern...]   Search text in workspace files
    search regex <pattern> [filePattern...]  Search regex in workspace
    search files [filePattern...]            Find files matching patterns
    search type <typeName>                   Open type by name
    search references <elemType> <elemName> [proj] [scope] [subtypes]  Find references
    search hierarchy <fullyQualifiedClass>   Get type hierarchy
    search call-hierarchy <class> <method> [sig]  Get call hierarchy
    search implementations <class> [method]  Find implementations

PROBLEMS:
    problems list [severity] [max]           Get problems (error/warning/all)
    problems quickfixes <file> [proj] [line] [id]  Get quick fixes
    problems apply-fix <file> <line> <idx> [proj]  Apply quick fix
    problems markers <file> [proj]           Get all markers for file

MAVEN:
    maven list                               List all Maven projects
    maven effective-pom <project>            Get effective POM
    maven dependencies <project>             Get project dependencies
    maven find-tests <project>               Find all test classes

REFACTOR:
    refactor rename-type <file> <newName> [proj]  Rename Java class/interface
    refactor move-type <file> <package> [proj]  Move type to package
    refactor rename-package <pkg> <newPkg> [proj]  Rename package
    refactor extract-method <file> <start> <end> <name> [proj] [vis]  Extract method
    refactor rename-file <file> <newName> [proj]  Rename file
    refactor move-resource <src> <target> [proj]  Move file/folder

CODE GENERATION:
    codegen getters-setters <file> [proj] [class] [fields]  Generate getters/setters
    codegen tostring <file> [proj] [class] [fields]  Generate toString/equals/hashCode
    codegen implement <file> [proj] [class] [methods]  Implement/override methods

FORMAT:
    format <file> [lines]                    Format file (optionally specific line ranges)

SOURCE OPERATIONS:
    source organize-imports <file> [proj]    Organize imports in file
    source organize-package <package> [proj] Organize imports in package
    source format <file> [lines]             Alias for 'format'

RUN:
    run [configuration] [--wait/-w]           Run Eclipse launch configuration

REFRESH:
    refresh workspace <paths...>             Refresh workspace paths
    refresh save <paths...>                  Refresh and save (triggers actions)

DEBUG:
    debug breakpoint add <file> <line> [cond]  Add breakpoint (optional condition)
    debug breakpoint remove <file> <line>    Remove breakpoint
    debug breakpoint list                    List all breakpoints
    debug breakpoint enable <file> <line>    Enable breakpoint
    debug breakpoint disable <file> <line>   Disable breakpoint
    debug run <configuration> [--wait/-w]     Run debug configuration
    debug configs                            List debug/run configurations
    debug config create-java <class> [options]  Create a Java-based launch configuration
      --type <java|junit4|junit5|testng|auto>  Select the configuration type
    debug config show <configuration> [--include-environment-values]  Show configuration details
    debug config update-environment <configuration> [options]  Update configuration environment
    debug threads                            List all threads
    debug thread-select <threadId>           Select thread for inspection
    debug step-into                          Step into next method call
    debug step-over                          Step over current line
    debug step-return                        Step out of current method
    debug resume                             Resume execution
    debug suspend                            Suspend execution
    debug terminate                          Terminate debug session
    debug stacktrace [threadId]              Get current stack trace
    debug variables [frameId]                Get variables in scope
    debug eval <expression> [frameId]        Evaluate expression
    debug status                             Get debug session status

COVERAGE:
    coverage run <configuration> [--wait/-w]  Run with code coverage (EclEmma)
    coverage report [project]                Get coverage report
    coverage class <project> <className>     Get coverage for a class

JAVA MEMBER EDITING:
    java write <file> [source] [-p proj] [-c class]  Write method/field/constructor (supports heredoc)
    java remove <file> [members] [-p proj] [-c class]  Remove members (supports heredoc/stdin)
    java read <file> [-p proj] [-c class]    Read Java class structure (fields, methods, etc.)

REMOVE OPERATIONS:
    remove lines <file> <lines> [-p proj]    Remove line ranges (e.g., '1-5,65,100-105')

GATE MANAGEMENT:
    gate reset [file] [-p proj]              Reset readJava cache for file or all files

DAEMON:
    daemon status                            Check daemon status
    daemon stop                              Stop daemon
    daemon restart                           Restart daemon

PERFORMANCE:
    ~25ms per command (ultra-fast bash + daemon architecture)
    First call starts daemon (~4s), subsequent calls are instant

EXAMPLES:
    eclipse project list
    eclipse test all
    eclipse code javadoc com.example.User
    eclipse search type "ArrayList"
    eclipse problems list error 10
    eclipse refactor rename-type /mnt/c/workspace/User.java UserEntity

    # Heredoc for multi-line code
    eclipse java write src/Main.java << 'EOF'
    public void hello() {
        System.out.println("Hello World");
    }
    EOF

TIPS:
    - After editing files externally, use 'eclipse refresh save <paths>' to sync Eclipse
    - All file paths are automatically converted from WSL to Windows format

For detailed docs, see: DAEMON.md and docs/ASSISTAI_TOOLS.md
EOF
}

# ===== Main command router =====

main() {
    # Check dependencies
    command -v nc >/dev/null || die "netcat (nc) not found. Install: apt install netcat"
    command -v jq >/dev/null || die "jq not found. Install: apt install jq"
    command -v wslpath >/dev/null || die "wslpath not found. Are you running in WSL?"

    # Parse command
    case "${1:-}" in
        # Help
        --help|-h|help|"")
            show_help
            ;;

        # Project commands
        project)
            shift
            case "${1:-}" in
                list) cmd_project_list ;;
                layout) shift; cmd_project_layout "$@" ;;
                properties) shift; cmd_project_properties "$@" ;;
                read) shift; cmd_project_read "$@" ;;
                import) shift; cmd_project_import "$@" ;;
                *) die "Unknown project command: ${1:-}. Try: list, layout, properties, read, import" ;;
            esac
            ;;

        # Workspace commands
        workspace)
            shift
            case "${1:-}" in
                info) cmd_workspace_info ;;
                *) die "Unknown workspace command: ${1:-}. Try: info" ;;
            esac
            ;;

        # Code commands
        code)
            shift
            case "${1:-}" in
                javadoc) shift; cmd_code_javadoc "$@" ;;
                source) shift; cmd_code_source "$@" ;;
                hierarchy) shift; cmd_code_hierarchy "$@" ;;
                *) die "Unknown code command: ${1:-}. Try: javadoc, source, hierarchy" ;;
            esac
            ;;

        # Build commands
        build)
            shift
            case "${1:-}" in
                maven) shift; cmd_build_maven "$@" ;;
                errors) shift; cmd_build_errors "$@" ;;
                *) die "Unknown build command: ${1:-}. Try: maven, errors" ;;
            esac
            ;;

        # Test commands
        test)
            shift
            case "${1:-}" in
                all) cmd_test_all ;;
                package) shift; cmd_test_package "$@" ;;
                class) shift; cmd_test_class "$@" ;;
                method) shift; cmd_test_method "$@" ;;
                *) die "Unknown test command: ${1:-}. Try: all, package, class, method" ;;
            esac
            ;;

        # Editor commands
        editor)
            shift
            case "${1:-}" in
                current) cmd_editor_current ;;
                selection) cmd_editor_selection ;;
                format) shift; cmd_editor_format "$@" ;;
                open) shift; cmd_editor_open "$@" ;;
                list) cmd_editor_list ;;
                *) die "Unknown editor command: ${1:-}. Try: current, selection, format, open, list" ;;
            esac
            ;;

        # Console commands
        console)
            shift
            case "${1:-}" in
                output) shift; cmd_console_output "$@" ;;
                *) die "Unknown console command: ${1:-}. Try: output" ;;
            esac
            ;;

        # Search commands
        search)
            shift
            case "${1:-}" in
                text) shift; cmd_search_text "$@" ;;
                regex) shift; cmd_search_regex "$@" ;;
                files) shift; cmd_search_files "$@" ;;
                type) shift; cmd_search_type "$@" ;;
                references) shift; cmd_search_references "$@" ;;
                hierarchy) shift; cmd_search_hierarchy "$@" ;;
                call-hierarchy) shift; cmd_search_call_hierarchy "$@" ;;
                implementations) shift; cmd_search_implementations "$@" ;;
                *) die "Unknown search command: ${1:-}. Try: text, regex, files, type, references, hierarchy, call-hierarchy, implementations" ;;
            esac
            ;;

        # Problems commands
        problems)
            shift
            case "${1:-}" in
                list) shift; cmd_problems_list "$@" ;;
                quickfixes) shift; cmd_problems_quickfixes "$@" ;;
                apply-fix) shift; cmd_problems_apply_fix "$@" ;;
                markers) shift; cmd_problems_markers "$@" ;;
                *) die "Unknown problems command: ${1:-}. Try: list, quickfixes, apply-fix, markers" ;;
            esac
            ;;

        # Maven commands
        maven)
            shift
            case "${1:-}" in
                list) cmd_maven_list ;;
                effective-pom) shift; cmd_maven_effective_pom "$@" ;;
                dependencies) shift; cmd_maven_dependencies "$@" ;;
                find-tests) shift; cmd_maven_find_tests "$@" ;;
                *) die "Unknown maven command: ${1:-}. Try: list, effective-pom, dependencies, find-tests" ;;
            esac
            ;;

        # Refactor commands
        refactor)
            shift
            case "${1:-}" in
                rename-type) shift; cmd_refactor_rename_type "$@" ;;
                move-type) shift; cmd_refactor_move_type "$@" ;;
                rename-package) shift; cmd_refactor_rename_package "$@" ;;
                extract-method) shift; cmd_refactor_extract_method "$@" ;;
                rename-file) shift; cmd_refactor_rename_file "$@" ;;
                move-resource) shift; cmd_refactor_move_resource "$@" ;;
                *) die "Unknown refactor command: ${1:-}. Try: rename-type, move-type, rename-package, extract-method, rename-file, move-resource" ;;
            esac
            ;;

        # Code generation commands
        codegen)
            shift
            case "${1:-}" in
                getters-setters) shift; cmd_codegen_getters_setters "$@" ;;
                tostring) shift; cmd_codegen_tostring "$@" ;;
                implement) shift; cmd_codegen_implement "$@" ;;
                *) die "Unknown codegen command: ${1:-}. Try: getters-setters, tostring, implement" ;;
            esac
            ;;

        # Format command (top-level)
        format)
            shift
            cmd_format "$@"
            ;;

        # Source operations commands
        source)
            shift
            case "${1:-}" in
                organize-imports) shift; cmd_source_organize_imports "$@" ;;
                organize-package) shift; cmd_source_organize_package "$@" ;;
                format) shift; cmd_format "$@" ;;
                *) die "Unknown source command: ${1:-}. Try: organize-imports, organize-package, format" ;;
            esac
            ;;

        # Run commands
        run)
            shift
            cmd_run "$@"
            ;;

        # Refresh commands
        refresh)
            shift
            case "${1:-}" in
                workspace) shift; cmd_refresh_workspace "$@" ;;
                save) shift; cmd_refresh_save "$@" ;;
                *) die "Unknown refresh command: ${1:-}. Try: workspace, save" ;;
            esac
            ;;

        # Debug commands
        debug)
            shift
            case "${1:-}" in
                breakpoint)
                    shift
                    case "${1:-}" in
                        add) shift; cmd_debug_breakpoint_add "$@" ;;
                        remove) shift; cmd_debug_breakpoint_remove "$@" ;;
                        list) cmd_debug_breakpoint_list ;;
                        enable) shift; cmd_debug_breakpoint_enable "$@" ;;
                        disable) shift; cmd_debug_breakpoint_disable "$@" ;;
                        *) die "Unknown breakpoint command: ${1:-}. Try: add, remove, list, enable, disable" ;;
                    esac
                    ;;
                run) shift; cmd_debug_run "$@" ;;
                configs) cmd_debug_configs ;;
                config)
                    shift
                    case "${1:-}" in
                        create-java) shift; cmd_debug_config_create_java "$@" ;;
                        show) shift; cmd_debug_config_show "$@" ;;
                        update-environment) shift; cmd_debug_config_update_environment "$@" ;;
                        *) die "Unknown config command: ${1:-}. Try: create-java, show, update-environment" ;;
                    esac
                    ;;
                threads) cmd_debug_threads ;;
                thread-select) shift; cmd_debug_thread_select "$@" ;;
                step-into) cmd_debug_step_into ;;
                step-over) cmd_debug_step_over ;;
                step-return) cmd_debug_step_return ;;
                resume) cmd_debug_resume ;;
                suspend) cmd_debug_suspend ;;
                terminate) cmd_debug_terminate ;;
                stacktrace) shift; cmd_debug_stacktrace "$@" ;;
                variables) shift; cmd_debug_variables "$@" ;;
                eval) shift; cmd_debug_eval "$@" ;;
                status) cmd_debug_status ;;
                *) die "Unknown debug command: ${1:-}. Try: breakpoint, run, configs, config, threads, step-into, step-over, step-return, resume, suspend, terminate, stacktrace, variables, eval, status" ;;
            esac
            ;;

        # Coverage commands
        coverage)
            shift
            case "${1:-}" in
                run) shift; cmd_coverage_run "$@" ;;
                report) shift; cmd_coverage_report "$@" ;;
                class) shift; cmd_coverage_class "$@" ;;
                *) die "Unknown coverage command: ${1:-}. Try: run, report, class" ;;
            esac
            ;;

        # Java member editing commands
        java)
            shift
            case "${1:-}" in
                write) shift; cmd_java_write "$@" ;;
                remove) shift; cmd_java_remove "$@" ;;
                read) shift; cmd_java_read "$@" ;;
                *) die "Unknown java command: ${1:-}. Try: write, remove, read" ;;
            esac
            ;;

        # Remove operations
        remove)
            shift
            case "${1:-}" in
                lines) shift; cmd_remove_lines "$@" ;;
                *) die "Unknown remove command: ${1:-}. Try: lines" ;;
            esac
            ;;

        # Gate management
        gate)
            shift
            case "${1:-}" in
                reset) shift; cmd_gate_reset "$@" ;;
                *) die "Unknown gate command: ${1:-}. Try: reset" ;;
            esac
            ;;

        # Daemon commands
        daemon)
            shift
            case "${1:-}" in
                status) cmd_daemon_status ;;
                stop) cmd_daemon_stop ;;
                restart) cmd_daemon_restart ;;
                *) die "Unknown daemon command: ${1:-}. Try: status, stop, restart" ;;
            esac
            ;;

        *)
            die "Unknown command: $1. Run 'eclipse --help' for usage."
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
