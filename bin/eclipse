# --- Coverage commands ---
cmd_coverage_run() {
    local config="" wait=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --wait|-w) wait=true; shift ;;
            *) config="$1"; shift ;;
        esac
    done
    [ -z "$config" ] && die "Usage: eclipse coverage run <configuration> [--wait]"
    local args="{\"configuration\":\"$config\"}"
    [ "$wait" = true ] && args="{\"configuration\":\"$config\",\"wait\":true}"
