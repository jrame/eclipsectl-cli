    daemon_call "$(build_json refresh "{\"path\":\"$paths\"}")"
}

cmd_refresh_save() {
    [ -z "${1:-}" ] && die "Usage: eclipse refresh save <paths...>"
    local paths
    paths=$(IFS=','; echo "$*")
    daemon_call "$(build_json refresh_and_save "{\"paths\":\"$paths\"}")"
}

